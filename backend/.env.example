# AgriConnect 2.0 - Backend Environment Variables
# Copy this file to .env in the backend folder for local deployment

# Database Configuration (Defaults to local SQLite file)
DATABASE_URL=sqlite:///./agriconnect.db
# For PostgreSQL (e.g. Render, Railway, Supabase):
# DATABASE_URL=postgresql://user:password@hostname:5432/agriconnect

# JWT Authentication
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial AgriConnect Administrator Account (Optional for local dev)
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=change_this_admin_password
ADMIN_NAME=AgriConnect Admin

# Port (Defaults to 8000)
PORT=8000
