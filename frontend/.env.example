# AgriConnect 2.0 - Frontend Environment Variables
# Copy to .env in frontend directory if overriding default proxy

# API Base URL
# In local development with Vite proxy, leave empty or set to /api
VITE_API_URL=/api

# For cross-origin production deployment (e.g. Vercel pointing to Render/Railway):
# VITE_API_URL=https://your-backend-api.onrender.com/api
